{
  "hosting": [
    {
      "target": "web",
      "public": "web/out",
      "headers": [
        {
          "source": "**/*",
          "headers": [
            {
              "key": "cache-control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|png|svg|css|js)",
          "headers": [
            {
              "key": "cache-control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "cleanUrls": true
    }
  ]
}
